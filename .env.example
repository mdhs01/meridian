# ── Wallet ────────────────────────────────────────────────────────────────────
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ── Solana RPC ─────────────────────────────────────────────────────────────────
RPC_URL=https://api.mainnet-beta.solana.com

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Option A: OpenRouter (recommended)
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# Option B: LM Studio (local) — uncomment these and comment out OPENROUTER_API_KEY
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=your-model-name-from-lmstudio

# ── API Keys ───────────────────────────────────────────────────────────────────
# GeckoTerminal - FREE, no key required
# DexScreener - FREE, no key required
# GMGN.ai - FREE (web scraping, no official API)
# RugCheck.xyz - FREE, no key required
# Jupiter - FREE, no key required
# Meteora - FREE (on-chain only)

# Optional: Helius for enhanced wallet data
HELIUS_API_KEY=your_helius_api_key_here

# Optional: LP Agent for top LPer studies
LPAGENT_API_KEY=your_lpagent_api_key_here

# Optional: OKX Web3 API (fallback for token data)
# OKX_API_KEY=your_okx_api_key
# OKX_SECRET_KEY=your_okx_secret
# OKX_PASSPHRASE=your_okx_passphrase
# OKX_PROJECT_ID=your_okx_project_id

# ── Telegram Notifications (optional) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Misc ───────────────────────────────────────────────────────────────────────
DRY_RUN=true
LOG_LEVEL=info
